                plagio_sub: "非對稱性顯著，需姿勢矯形或轉介",
                mild_mod_text: "輕度至中度 (Mild to Moderate)",
                severe_text: "重度 (Severe)",
                care_plan_title: "建議護理方案 (Implementation Care Plan)",
                care_norm_title: "正常 (Normal)",
                care_norm_1: "每3-4小時擺放身體與頭部呈對齊姿態 (Q3-4H)",
                care_norm_2: "預防性日常擺位與親子趴趴時光 (Tummy time)",
