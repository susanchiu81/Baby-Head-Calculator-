                care_severe_title: "重度 / 斜頭症 (Severe / Plagiocephaly)",
                care_severe_1: "安排專科或物理治療轉介 (Referral)",
                care_severe_2: "專業頭盔矯形評估與臨床指導 (Orthotic Helmet)"
            },
            en: {
                app_title: "Infant Head Shape Calculator",
                btn_reset: "Reset",
                guide_title: "Clinical Measurement Guide:",
                guide_desc: "Calculated based on clinical cranial protocols. Enter measurements obtained using a craniometer caliper (unit: mm). Ensure consistent units.",
                ci_title: "1. Cranial Index (CI)",
                ci_desc: "Used to assess Dolichocephaly or Brachycephaly.",
                lbl_bpd: "Biparietal Diameter BPD (Width)",
                lbl_apd: "Anteroposterior Diameter APD (Length)",
                cvai_title: "2. Cranial Vault Asymmetry Index (CVAI)",
                cvai_desc: "Used to assess Plagiocephaly (Asymmetry).",
                lbl_crl: "Cranial Length CrL",
                lbl_crl_sub: "Glabella to occipital protuberance",
                lbl_crw: "Cranial Width CrW",
                lbl_crw_sub: "Maximum width between parietal bones",
                lbl_result: "Result",
                ref_table_title: "Clinical Reference & Care Implementation Standards",
                tbl_ci_header: "CI Classification",
                tbl_cvai_header: "CVAI Classification",
                norm_text: "Normal",
                doli_text: "Dolichocephaly",
                brachy_text: "Brachycephaly",
                plagio_text: "Plagiocephaly",
                plagio_sub: "Significant asymmetry; intervention required",
                mild_mod_text: "Mild to Moderate",
                severe_text: "Severe",
                care_plan_title: "Implementation Care Plan",
                care_norm_title: "Normal",
                care_norm_1: "Reposition body and head in alignment Q3-4H",
                care_norm_2: "Preventative positioning and supervised tummy time",
                care_mild_title: "Mild to Moderate",
                care_mild_1: "Equal-time symmetrical rotation (Supine → L lateral → R lateral)",
                care_mild_2: "Use Gel pillow / Contoured positioning pillow",
                care_severe_title: "Severe / Plagiocephaly",
                care_severe_1: "Referral to Specialist / Physical Therapy",
                care_severe_2: "Orthotic Helmet evaluation & professional guidance"
            }
        };

        let currentLang = 'zh';

        // Initialize Lucide Icons
        lucide.createIcons();

        // Language Switcher Function
        function toggleLanguage() {
            currentLang = currentLang === 'zh' ? 'en' : 'zh';
            document.getElementById('langLabel').innerText = currentLang === 'zh' ? 'English' : '繁體中文';

            // Apply text replacements
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (i18n[currentLang][key]) {
                    el.innerText = i18n[currentLang][key];
                }
            });

            // Re-evaluate current calculations to update badges language
            calculateCI();
            calculateCVAI();
        }

        // Calculation: Cranial Index (CI)
        function calculateCI() {
            const bpd = parseFloat(document.getElementById('bpdInput').value);
            const apd = parseFloat(document.getElementById('apdInput').value);

            const ciValueEl = document.getElementById('ciValue');
            const ciBadge = document.getElementById('ciBadge');
            const ciIcon = document.getElementById('ciIcon');
            const ciStatusText = document.getElementById('ciStatusText');
            const ciCategoryText = document.getElementById('ciCategoryText');

            if (isNaN(bpd) || isNaN(apd) || apd <= 0 || bpd <= 0) {
                ciValueEl.innerText = '-- %';
                ciValueEl.className = 'text-2xl font-extrabold text-slate-300';
                ciBadge.classList.add('hidden');
                return;
            }

            const ci = (bpd / apd) * 100;
            ciValueEl.innerText = ci.toFixed(1) + '%';
            ciBadge.classList.remove('hidden');

            const isZh = currentLang === 'zh';

            // Classification Logic
            if (ci >= 75 && ci <= 85) {
                // Normal
                ciValueEl.className = 'text-2xl font-extrabold text-emerald-600';
                ciBadge.className = 'p-3 rounded-xl border bg-emerald-50 border-emerald-200 text-emerald-800 text-sm font-medium flex items-center justify-between';
                ciStatusText.innerText = isZh ? '正常 (Normal)' : 'Normal';
                ciCategoryText.innerText = isZh ? '標準頭型' : 'Standard';
                ciIcon.setAttribute('data-lucide', 'check-circle');
            } else if (ci >= 60 && ci < 75) {
                // Dolichocephaly Mild to Moderate
                ciValueEl.className = 'text-2xl font-extrabold text-amber-600';
                ciBadge.className = 'p-3 rounded-xl border bg-amber-50 border-amber-200 text-amber-800 text-sm font-medium flex items-center justify-between';
                ciStatusText.innerText = isZh ? '長頭症 (Dolichocephaly)' : 'Dolichocephaly';
                ciCategoryText.innerText = isZh ? '輕度至中度 (Mild to Moderate)' : 'Mild to Moderate';
                ciIcon.setAttribute('data-lucide', 'alert-triangle');
            } else if (ci < 60) {
                // Dolichocephaly Severe
                ciValueEl.className = 'text-2xl font-extrabold text-rose-600';
                ciBadge.className = 'p-3 rounded-xl border bg-rose-50 border-rose-200 text-rose-800 text-sm font-medium flex items-center justify-between';
                ciStatusText.innerText = isZh ? '長頭症 (Dolichocephaly)' : 'Dolichocephaly';
                ciCategoryText.innerText = isZh ? '重度 (Severe)' : 'Severe';
                ciIcon.setAttribute('data-lucide', 'alert-octagon');
            } else if (ci > 85 && ci <= 100) {
                // Brachycephaly Mild to Moderate
                ciValueEl.className = 'text-2xl font-extrabold text-amber-600';
                ciBadge.className = 'p-3 rounded-xl border bg-amber-50 border-amber-200 text-amber-800 text-sm font-medium flex items-center justify-between';
                ciStatusText.innerText = isZh ? '短頭症/平頭 (Brachycephaly)' : 'Brachycephaly';
                ciCategoryText.innerText = isZh ? '輕度至中度 (Mild to Moderate)' : 'Mild to Moderate';
                ciIcon.setAttribute('data-lucide', 'alert-triangle');
            } else if (ci > 100) {
                // Brachycephaly Severe
                ciValueEl.className = 'text-2xl font-extrabold text-rose-600';
                ciBadge.className = 'p-3 rounded-xl border bg-rose-50 border-rose-200 text-rose-800 text-sm font-medium flex items-center justify-between';
                ciStatusText.innerText = isZh ? '短頭症/平頭 (Brachycephaly)' : 'Brachycephaly';
                ciCategoryText.innerText = isZh ? '重度 (Severe)' : 'Severe';
                ciIcon.setAttribute('data-lucide', 'alert-octagon');
            }

            lucide.createIcons();
        }

        // Calculation: Cranial Vault Asymmetry Index (CVAI)
        function calculateCVAI() {
            const crl = parseFloat(document.getElementById('crlInput').value);
            const crw = parseFloat(document.getElementById('crwInput').value);

            const cvaiValueEl = document.getElementById('cvaiValue');
            const cvaiBadge = document.getElementById('cvaiBadge');
            const cvaiIcon = document.getElementById('cvaiIcon');
            const cvaiStatusText = document.getElementById('cvaiStatusText');
            const cvaiCategoryText = document.getElementById('cvaiCategoryText');

            if (isNaN(crl) || isNaN(crw)) {
                cvaiValueEl.innerText = '--';
                cvaiValueEl.className = 'text-2xl font-extrabold text-slate-300';
                cvaiBadge.classList.add('hidden');
                return;
            }

            // Standard difference calculation: | CrL - CrW |
            const cvai = Math.abs(crl - crw);
            cvaiValueEl.innerText = cvai.toFixed(1) + ' mm';
            cvaiBadge.classList.remove('hidden');

            const isZh = currentLang === 'zh';

            if (cvai > 3.5) {
                // Plagiocephaly
                cvaiValueEl.className = 'text-2xl font-extrabold text-rose-600';
                cvaiBadge.className = 'p-3 rounded-xl border bg-rose-50 border-rose-200 text-rose-800 text-sm font-medium flex items-center justify-between';
                cvaiStatusText.innerText = isZh ? '斜頭症 (Plagiocephaly)' : 'Plagiocephaly';
                cvaiCategoryText.innerText = 'CVAI > 3.5';
                cvaiIcon.setAttribute('data-lucide', 'alert-octagon');
            } else {
                // Normal
                cvaiValueEl.className = 'text-2xl font-extrabold text-emerald-600';
                cvaiBadge.className = 'p-3 rounded-xl border bg-emerald-50 border-emerald-200 text-emerald-800 text-sm font-medium flex items-center justify-between';
                cvaiStatusText.innerText = isZh ? '正常 (Normal)' : 'Normal';
                cvaiCategoryText.innerText = 'CVAI ≤ 3.5';
                cvaiIcon.setAttribute('data-lucide', 'check-circle');
            }

            lucide.createIcons();
        }

        // Reset Inputs
        function resetAll() {
            document.getElementById('bpdInput').value = '';
            document.getElementById('apdInput').value = '';
            document.getElementById('crlInput').value = '';
            document.getElementById('crwInput').value = '';

            calculateCI();
            calculateCVAI();
        }
    </script>
</body>
</html>
