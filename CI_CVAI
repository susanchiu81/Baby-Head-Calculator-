                lbl_crl: "頭長 CrL (Cranial Length)",
                lbl_crl_sub: "測量位置：眉間點至枕外隆凸",
                lbl_crw: "頭寬 CrW (Cranial Width)",
                lbl_crw_sub: "測量位置：兩側頂骨間最大距離",
                lbl_result: "計算結果",
                ref_table_title: "頭型診斷基準與臨床處置對照表 (Implementation Standards)",
                tbl_ci_header: "CI 頭型指數分類",
                tbl_cvai_header: "CVAI 頭形非對稱指數分類",
                norm_text: "正常 (Normal)",
                doli_text: "長頭症 (Dolichocephaly)",
                brachy_text: "短頭症/平頭 (Brachycephaly)",
